# =============================================================================
# LMEX INTERNATIONAL — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# WARNING: NEVER commit real .env files with actual secrets to GitHub!
# This template (.env.example) serves as a safe guide for local development.
#
# Rules for Vite & React Security:
# 1. Variables starting with VITE_ are bundled into public client-side JavaScript.
#    NEVER place private backend secret keys into VITE_ variables!
# 2. Add real credentials only in your local untracked `.env.local` or directly
#    in Vercel Project Settings > Environment Variables for production.
# =============================================================================

# Public Site Configuration
VITE_SITE_URL=https://www.lmexint.com
VITE_APP_ENV=production

# Support Contact Defaults
VITE_SUPPORT_EMAIL=support@lmexinternational.com
VITE_WHATSAPP_NUMBER=8801337017967
